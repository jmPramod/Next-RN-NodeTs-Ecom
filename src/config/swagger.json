{
  "swagger": "2.0",
  "info": {
    "title": "E-Commerce API",
    "description": "Complete API documentation for Admin, Products, Cart, Orders, Reviews and User modules",
    "version": "1.0.0"
  },
  "host": "https://next-rn-node-ts-ecom.vercel.app",
  "basePath": "/api",
  "schemes": ["http","https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],

  "securityDefinitions": {
    "JWTAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer <JWT_TOKEN>"
    }
  },

  "tags": [
    { "name": "Admin" },
    { "name": "Products" },
    { "name": "Cart" },
    { "name": "Orders" },
    { "name": "Reviews" },
    { "name": "User" }
  ],

  "paths": {
    "/admin/products": {
      "post": {
        "tags": ["Admin"],
        "summary": "Create product",
        "security": [{ "JWTAuth": [] }],
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "name", "in": "formData", "required": true, "type": "string" },
          { "name": "price", "in": "formData", "required": true, "type": "number" },
          { "name": "images", "in": "formData", "type": "file", "required": false }
        ],
        "responses": { "201": { "description": "Product created" } }
      },
      "get": {
        "tags": ["Admin"],
        "summary": "Get all products (Admin)",
        "security": [{ "JWTAuth": [] }],
        "responses": {
          "200": {
            "description": "Products list",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Product" } }
          }
        }
      }
    },

    "/admin/products/{id}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Update product",
        "security": [{ "JWTAuth": [] }],
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "name", "in": "formData", "type": "string" },
          { "name": "price", "in": "formData", "type": "number" }
        ],
        "responses": { "200": { "description": "Product updated" } }
      }
    },

    "/admin/orders": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get all orders",
        "security": [{ "JWTAuth": [] }],
        "responses": {
          "200": {
            "description": "Orders fetched",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Order" } }
          }
        }
      }
    },

    "/admin/orders/{orderId}/status": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Update order status",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "Delivered" }
              }
            }
          }
        ],
        "responses": { "200": { "description": "Status updated" } }
      }
    },

    "/admin/customer": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get all customers",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Customers fetched" } }
      }
    },

    "/admin/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get dashboard stats",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Stats fetched" } }
      }
    },

    "/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get cart",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Cart fetched" } }
      },
      "post": {
        "tags": ["Cart"],
        "summary": "Add item to cart",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "cart",
            "required": true,
            "schema": { "$ref": "#/definitions/Cart" }
          }
        ],
        "responses": { "201": { "description": "Item added" } }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Clear cart",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Cart cleared" } }
      }
    },

    "/cart/{productId}": {
      "patch": {
        "tags": ["Cart"],
        "summary": "Update cart item",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Cart updated" } }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Delete cart item",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Item removed" } }
      }
    },

    "/order": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create order",
        "security": [{ "JWTAuth": [] }],
        "responses": { "201": { "description": "Order created" } }
      },
      "get": {
        "tags": ["Orders"],
        "summary": "Get user orders",
        "security": [{ "JWTAuth": [] }],
        "responses": {
          "200": {
            "description": "Orders fetched",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Order" } }
          }
        }
      }
    },

    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get products",
        "security": [{ "JWTAuth": [] }],
        "responses": {
          "200": {
            "description": "Products list",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Product" } }
          }
        }
      }
    },

    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product by ID",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Product fetched",
            "schema": { "$ref": "#/definitions/Product" }
          }
        }
      }
    },

    "/reviews": {
      "post": {
        "tags": ["Reviews"],
        "summary": "Create review",
        "security": [{ "JWTAuth": [] }],
        "responses": { "201": { "description": "Review created" } }
      }
    },

    "/reviews/{reviewId}": {
      "delete": {
        "tags": ["Reviews"],
        "summary": "Delete review",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "reviewId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Review deleted" } }
      }
    },

    "/address": {
      "post": {
        "tags": ["User"],
        "summary": "Add address",
        "security": [{ "JWTAuth": [] }],
        "responses": { "201": { "description": "Address added" } }
      },
      "get": {
        "tags": ["User"],
        "summary": "Get addresses",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Addresses fetched" } }
      }
    },

    "/address/{addressId}": {
      "patch": {
        "tags": ["User"],
        "summary": "Update address",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "addressId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Address updated" } }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Delete address",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "addressId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Address deleted" } }
      }
    },

    "/wishlist": {
      "post": {
        "tags": ["User"],
        "summary": "Add to wishlist",
        "security": [{ "JWTAuth": [] }],
        "responses": { "201": { "description": "Added to wishlist" } }
      },
      "get": {
        "tags": ["User"],
        "summary": "Get wishlist",
        "security": [{ "JWTAuth": [] }],
        "responses": { "200": { "description": "Wishlist fetched" } }
      }
    },

    "/wishlist/{productId}": {
      "delete": {
        "tags": ["User"],
        "summary": "Remove wishlist item",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "Wishlist item removed" } }
      }
    }
  },

  "definitions": {
    "Product": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" }
      }
    },
    "Cart": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "number" }
      }
    }
  }
}